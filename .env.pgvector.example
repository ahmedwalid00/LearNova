# PGVector Configuration Example
# Add these to your .env or .env.docker file

# Vector Database Configuration
VECTOR_DB_BACKEND=PGVECTOR
VECTOR_DB_DISTANCE_METHOD=cosine
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100

# LLM and Embedding Configuration
GENERATION_BACKEND=openai
EMBEDDING_BACKEND=openai
GENERATION_MODEL_ID=gpt-3.5-turbo
EMBEDDING_MODEL_ID=text-embedding-ada-002
EMBEDDING_MODEL_SIZE=1536
INPUT_DEFAULT_MAX_CHARACTERS=4000
GENERATION_DEFAULT_MAX_TOKENS=1000
GENERATION_DEFAULT_TEMPERATURE=0.7

# Required: Your OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Cohere API Key (if using Cohere backend)
COHERE_API_KEY=your_cohere_api_key_here
